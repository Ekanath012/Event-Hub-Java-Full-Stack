# Local Docker development only. Never commit a real .env file.
DB_NAME=eventhub_db
DB_USERNAME=eventhub
DB_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PORT=3306
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ALLOWED_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api
COOKIE_SECURE=false
# Local development: Mailpit captures email at http://localhost:8025
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRATION_MINUTES=15
